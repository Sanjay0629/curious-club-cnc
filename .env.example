# Copy to .env and fill in from Supabase Dashboard → Project Settings → API Keys / Data API.
# Only public values belong here: they are bundled into the browser code.
# Never put the service_role / secret key or the Google client secret in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
